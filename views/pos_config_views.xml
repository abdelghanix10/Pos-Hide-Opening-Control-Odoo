<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_config_form_view_inherit" model="ir.ui.view">
        <field name="name">pos.config.form.view.inherit.hide_opening_control</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@class='row mt16 o_settings_container' and @invisible=&quot;context.get('pos_config_create_mode', False)&quot;]" position="inside">
                <setting string="Hide Opening Cash Control" help="Automatically hide the opening cash control popup and set cash to 0">
                    <field name="hide_opening_control"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>