<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_config_form_view_inherit" model="ir.ui.view">
        <field name="name">pos.config.form.view.inherit.hide_opening_control</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='other_devices']" position="after">
                <setting string="Hide Opening Cash Control" help="Automatically hide the opening cash control popup and set cash to the default amount">
                    <field name="hide_opening_control"/>
                    <div invisible="not hide_opening_control" class="mt-2">
                        <field name="default_opening_cash" widget="float" class="oe_inline"/>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>